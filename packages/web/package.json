{
  "name": "@agent-tracker/web",
  "version": "0.0.3",
  "private": true,
  "description": "Web dashboard for Agent Tracker - browser-based session monitoring",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "BASE_PATH=/agent-tracker vite",
    "build": "vite build",
    "build:proxy": "BASE_PATH=/agent-tracker vite build",
    "start": "node .output/server/index.mjs",
    "start:proxy": "BASE_PATH=/agent-tracker node .output/server/index.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@agent-tracker/core": "*",
    "@tanstack/react-query": "^5.64.2",
    "@tanstack/react-router": "^1.151.6",
    "@tanstack/react-start": "^1.151.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
